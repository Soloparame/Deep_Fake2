# Copy to fastapi_backend/.env (never commit .env)

MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority

# Required for image + video detection (Hugging Face)
HF_TOKEN=hf_your_token_here

# Required for Project Intel competitors, SWOT, strategy (Groq)
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Semantic Scholar Academic Graph + Recommendations APIs (Project Intel similar papers/PDFs)
# Get a key: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

VIDEO_USE_HF_API=true
FRONTEND_URL=http://localhost:3000

# Optional email (password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
